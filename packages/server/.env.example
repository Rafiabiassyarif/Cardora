# Salin ke packages/server/.env lalu sesuaikan. Semua opsional kecuali ditandai.

PORT=3000
HOST=0.0.0.0

# Sajikan build web dari server yang sama (satu port untuk web + multiplayer).
WEB_DIST=../web/dist

# Origin lain yang boleh konek (pisahkan koma). Kosong = same-origin + localhost + aplikasi Capacitor.
CORS_ORIGINS=

# Akun & statistik (PostgreSQL 13+). Kosong = mode tamu saja (multiplayer tetap jalan).
DATABASE_URL=
# WAJIB di production bila DATABASE_URL diisi. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Masuk dengan Google (opsional). Buat OAuth Client ID tipe "Web application" di
# https://console.cloud.google.com/apis/credentials lalu tambahkan Authorized JavaScript origins:
#   http://localhost:5173  (dev)  dan domain produksi (mis. https://kuypoker.example.com)
# Client ID bersifat publik (bukan rahasia). Kosong = tombol Google dinonaktifkan.
GOOGLE_CLIENT_ID=

# Gameplay & kapasitas
TURN_SECONDS=30
RECONNECT_GRACE_SECONDS=60
ROOM_IDLE_MINUTES=30
MAX_ROOMS=2000

# Rate limit per IP
CREATE_ROOM_BURST=5
JOIN_BURST=10

LOG_LEVEL=info
